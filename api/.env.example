# Copy to api/.env. Values below are the local-dev defaults that work with
# .local/compose.yaml. Never commit the real .env.

# MySQL from .local/compose.yaml (note port 3307 on the host)
DATABASE_URL=mysql://root:nuhire@127.0.0.1:3307/nuhire

BACKEND_PORT=5001

# Any random string locally. Generate a real one for deploys:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=local-dev-session-secret

# Where the frontend lives. Used for CORS and post-login redirects.
REACT_APP_FRONT_URL=http://localhost:3000

# Keycloak. Must be reachable at this URL from BOTH the browser and this process.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=NUHire-Realm
KEYCLOAK_CLIENT_ID=NUHire-Client
KEYCLOAK_CLIENT_SECRET=thJZ4vpuH8ch3cEEvfplB0X9CjOuhXgD
KEYCLOAK_CALLBACK_URL=http://localhost:5001/auth/keycloak/callback

# Second, legacy auth system gating /mod-dashboard (the page that grants
# teacher access). Scheduled for removal. If these are unset the endpoint
# currently accepts an empty body, so set them.
MODERATOR_USERNAME=admin
MODERATOR_PASSWORD=admin

# Browsers drop Secure cookies over plain http, so local dev must set this to
# false. Leave it UNSET in deploys to keep secure + sameSite=none.
COOKIE_SECURE=false

# Reject Socket.IO connections that carry no login session.
#
# The socket layer now reads the session from the handshake and refuses to join
# a student to another group's room. This flag controls the last step: dropping
# an unauthenticated socket instead of letting it connect unpoliced.
#
# It is off because turning it on is the one change that can disconnect every
# client at once, and nobody has run two real browser sessions against it yet.
# To turn it on: set it in staging, log in as a student and an advisor, confirm
# the API stops logging "connected with no session", then set it in production.
SOCKET_AUTH_REQUIRED=false
