# Local dev only; production builds from ./dockerfile.
FROM node:22-alpine

WORKDIR /apicode

COPY package*.json tsconfig.json ./
RUN npm ci

COPY src/ ./src/
COPY uploads/ ./uploads/
RUN npx tsc

EXPOSE 5001

# Migrations first, as `npm start` does in production: if one fails, the API
# does not start. compose.dev.yaml mounts them at /database-files/migrations.
CMD ["sh", "-c", "npm run db:migrate && { npx tsc --watch --preserveWatchOutput & exec node --watch dist/server.js; }"]
