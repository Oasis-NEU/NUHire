# Local dev only; production builds from ./dockerfile.
FROM node:22-alpine

WORKDIR /apicode

COPY package*.json tsconfig.json ./
RUN npm ci

COPY src/ ./src/
COPY uploads/ ./uploads/
RUN npx tsc

EXPOSE 5001

CMD ["sh", "-c", "npx tsc --watch --preserveWatchOutput & exec node --watch dist/server.js"]
